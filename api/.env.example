# Verifiko API — example environment.
# Copy to `.env` for local development: `cp .env.example .env`.
# Every value here is a placeholder or a local-dev default; never commit real secrets.
# Anything left unset falls back to the default in app/infrastructure/config/settings.py.

# --- App ---------------------------------------------------------------------
# development | test | production. Anything other than development/dev/local/test
# is treated as production (and VERCEL_ENV=production always is).
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Signing secrets ---------------------------------------------------------
# Required in production: the API refuses to start there if either one is unset,
# blank, or left at its built-in development default. Generate each with:
#   openssl rand -hex 32
# Leave them commented out locally to use the development defaults.
# AUTH_TOKEN_SECRET=
# SCAN_WEBHOOK_SIGNING_SECRET=

# --- Database (PostgreSQL, psycopg v3) ---------------------------------------
# Local default matches `docker compose up -d db`. In production use your managed
# Postgres URL, e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
# (a bare postgresql:// URL is normalized to postgresql+psycopg:// automatically).
DATABASE_URL=postgresql+psycopg://verifiko:verifiko@localhost:5432/verifiko

# --- Redis (optional) --------------------------------------------------------
# Rate/quota limiters and caches. Empty = no Redis: caches are skipped and limiters
# use their non-Redis fallback (fine for local dev).
# Example: rediss://default:password@host:6379
REDIS_URL=

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional regex for controlled preview-origin access. Leave unset unless you intend to allow it.
# CORS_ALLOWED_ORIGIN_REGEX=

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for client IPs.
TRUSTED_PROXY_IPS=

# --- Auth --------------------------------------------------------------------
# Google Sign-In: the same OAuth web client ID configured in the web app
# (VITE_GOOGLE_CLIENT_ID). Empty = Google Sign-In disabled.
GOOGLE_CLIENT_ID=

# Magic-link email login (optional). Empty RESEND_API_KEY = no email is sent; the
# link is written to the API log instead (handy for local dev).
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
# MAGIC_LINK_FROM_EMAIL=login@example.com
# Where the emailed link points (the web app).
MAGIC_LINK_BASE_URL=http://localhost:5173

# --- Detection -----------------------------------------------------------------
VERIFICATION_PARALLEL_ANALYSIS_ENABLED=true
# Skip network-bound analysis when the URL alone is already HIGH/CRITICAL.
VERIFICATION_FAST_PATH_ENABLED=false

# OpenPhish reputation feed (optional).
OPENPHISH_REPUTATION_ENABLED=false

# --- Async scans -------------------------------------------------------------
# "thread" (in-process, default) | "qstash" (Upstash QStash, for serverless).
SCAN_DISPATCH_MODE=thread
# QStash (optional; only used when SCAN_DISPATCH_MODE=qstash).
QSTASH_TOKEN=
# Public URL of this API's internal worker route, e.g. https://api.example.com/api/v1/scans/process
QSTASH_WORKER_CALLBACK_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Headless detonation (optional, async scans only) ------------------------
DETONATION_ENABLED=false
# Browserless endpoint; its URL carries the token, e.g. https://<region>.browserless.io?token=<token>
BROWSERLESS_ENDPOINT=

# --- Screenshot storage (optional, Cloudflare R2 / S3-compatible) ------------
SCREENSHOT_STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
