# Required in Vercel production deployments. Set this to the deployed API base URL.
# Example: VITE_API_BASE_URL=https://<api-vercel-url>
VITE_API_BASE_URL=https://<api-vercel-url>

# Required for Google Sign-In. Use the same Google OAuth web client ID configured in the API.
# Example: VITE_GOOGLE_CLIENT_ID=123456789012-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
